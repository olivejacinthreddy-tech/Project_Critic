# ==============================================================
# AI PROJECT IDEA CRITIC AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Port
PORT=5000

# Client Port (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Obtain your free or paid API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model (Defaults to gemini-2.5-flash or gemini-1.5-flash or gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Connection String (Optional)
# If left blank or if MongoDB is not running locally, the server
# automatically uses a persistent JSON file database in server/data/projects.json
MONGODB_URI=mongodb://localhost:27017/critic_agent

# Node Environment ('development' or 'production')
NODE_ENV=development
